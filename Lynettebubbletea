    function sendSmsCode() {
      const code = document.getElementById('vip-country-code').value;
      const rawPhone = document.getElementById('vip-phone-input').value.trim().replace(/\s+/g, '');

      if (!/^\d{6,11}$/.test(rawPhone)) {
        showToast('⚠️ 請先輸入 6 至 11 位手機號碼再獲取驗證碼！');
        return;
      }

      // 產生 6 位隨機驗證碼
      generatedSmsCode = String(Math.floor(100000 + Math.random() * 900000));
      generatedSmsTarget = `${code}-${rawPhone}`;

      // 顯示模擬手機簡訊通知橫幅
      const smsBanner = document.getElementById('sms-banner');
      document.getElementById('sms-banner-body').innerHTML =
        `發送至 <strong>${code} ${rawPhone}</strong>：您的 VIP 驗證碼為 <strong class="text-[#ffd54f] text-sm tracking-wider">${generatedSmsCode}</strong>（5分鐘內有效）`;
      smsBanner.classList.remove('hidden');

      // 啟動 60 秒重新發送倒數
      const sendBtn = document.getElementById('send-sms-btn');
      let cooldown = 60;
      sendBtn.disabled = true;
      sendBtn.textContent = `${cooldown}s 後重發`;

      clearInterval(smsCooldownTimer);
      smsCooldownTimer = setInterval(() => {
        cooldown--;
        if (cooldown <= 0) {
          clearInterval(smsCooldownTimer);
          sendBtn.disabled = false;
          sendBtn.textContent = '獲取驗證碼';
        } else {
          sendBtn.textContent = `${cooldown}s 後重發`;
        }
      }, 1000);

      showToast(`📩 驗證碼已發送至 ${code} ${rawPhone}`);
    }

    function autoFillGeneratedCode() {
      if (generatedSmsCode) {
        document.getElementById('vip-sms-input').value = generatedSmsCode;
        document.getElementById('sms-banner').classList.add('hidden');
