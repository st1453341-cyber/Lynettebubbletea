    // 即時計算彈窗內的單杯與總計價格
    function calculateModalUnitPrice() {
      if (!selectedDrink) return 0;
      let price = selectedDrink.price;

      // 加上杯型差價
      const sizeInput = document.querySelector('input[name="modal-size"]:checked');
      if (sizeInput) price += parseFloat(sizeInput.value);

      // 加上所有勾選的配料價格
      document.querySelectorAll('.modal-topping-cb:checked').forEach(cb => {
        price += parseFloat(cb.value);
      });

      return price;
    }

    function updateModalPrice() {
      const unitPrice = calculateModalUnitPrice();
      const total = unitPrice * modalQty;
      document.getElementById('modal-total-btn-price').textContent = `$${total.toFixed(2)}`;
    }

