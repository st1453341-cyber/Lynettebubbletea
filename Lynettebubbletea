<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>蜜雪冰城風味珍珠奶茶點餐與購物車 ⛄🧋</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&display=swap');
    body {
      font-family: 'Noto Sans TC', sans-serif;
      background: linear-gradient(135deg, #fff5f5 0%, #fff8e1 50%, #ffebee 100%);
      min-height: 100vh;
    }
    .menu-card {
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .menu-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 24px rgba(230, 0, 18, 0.14);
    }
    .drink-img {
      transition: transform 0.35s ease;
    }
    .menu-card:hover .drink-img {
      transform: scale(1.06);
    }
    @keyframes pop {
      0% { transform: scale(0.92); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }
    .animate-pop {
      animation: pop 0.22s ease-out forwards;
    }
  </style>
</head>
<body class="pb-12 text-[#3d231d]">

  <!-- 頂部品牌導覽列 -->
  <header class="bg-gradient-to-r from-[#e60012] via-[#f42b3b] to-[#ff5252] text-white sticky top-0 z-30 shadow-lg">
    <div class="max-w-6xl mx-auto px-4 py-3.5 flex items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-2xl bg-white text-[#e60012] flex items-center justify-center text-2xl shadow-md shrink-0">
          ⛄
        </div>
        <div>
          <h1 class="font-black text-lg sm:text-xl tracking-wide leading-tight">MIXUE 蜜雪甜蜜點餐</h1>
          <p class="text-[11px] sm:text-xs text-red-100">新鮮冰淇淋與茶飲・外帶自取 / 外賣直送</p>
        </div>
      </div>

      <!-- 手機版快速跳轉購物車按鈕 -->
      <button 
        onclick="scrollToCart()" 
        class="lg:hidden bg-white text-[#e60012] font-bold px-3.5 py-2 rounded-full shadow-md flex items-center gap-1.5 text-sm active:scale-95 transition cursor-pointer"
      >
        <span>🛒 購物車</span>
        <span id="mobile-cart-badge" class="bg-[#e60012] text-white text-xs px-2 py-0.5 rounded-full">0</span>
      </button>
    </div>
  </header>

  <!-- 取餐與外賣配送地點選擇列 (Take-Out & Delivery Location Selector) -->
  <section class="max-w-6xl mx-auto px-4 pt-4">
    <div class="bg-white rounded-[22px] p-3.5 sm:px-5 sm:py-4 border-2 border-[#ffcdd2] shadow-xs space-y-3">
      
      <!-- 模式切換：門市外帶自取 vs 外賣送貨上門 -->
      <div class="flex flex-wrap items-center justify-between gap-2 pb-2.5 border-b border-dashed border-[#ffe0e3]">
        <div class="flex items-center gap-2">
          <button 
            type="button" 
            id="mode-takeout-btn" 
            onclick="switchOrderMode('takeout')" 
            class="px-3.5 py-1.5 rounded-full bg-[#e60012] text-white font-bold text-xs sm:text-sm shadow-xs transition cursor-pointer flex items-center gap-1.5"
          >
            <span>🛍️ 門市外帶自取</span>
          </button>
          <button 
            type="button" 
            id="mode-delivery-btn" 
            onclick="switchOrderMode('delivery')" 
            class="px-3.5 py-1.5 rounded-full bg-[#fff5f5] text-[#5d4037] hover:bg-[#ffebee] border border-[#ffcdd2] font-bold text-xs sm:text-sm transition cursor-pointer flex items-center gap-1.5"
          >
            <span>🛵 外賣送貨上門 (Delivery)</span>
          </button>
        </div>
        <span id="order-mode-eta" class="bg-[#e8f5e9] text-[#2e7d32] text-[11px] font-bold px-2.5 py-1 rounded-full">
          ● 營業中・約 5-10 分鐘可取
        </span>
      </div>

      <!-- 1. 外帶自取門市選擇面板 -->
      <div id="takeout-location-panel" class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-[#ffebee] text-[#e60012] flex items-center justify-center text-xl shrink-0">
            🏪
          </div>
          <div>
            <span class="text-[11px] font-bold text-[#e60012] bg-[#ffebee] px-2 py-0.5 rounded-md">外帶自取門市 Take-Out Location</span>
            <p id="store-address-display" class="text-xs text-[#5d4037] mt-1 font-medium">澳門板樟堂街 / 議事亭前地（大三巴步行街入口旁・外帶取餐櫃檯 1 號窗）</p>
          </div>
        </div>

        <div class="w-full sm:w-auto">
          <select 
            id="pickup-location-select" 
            onchange="updatePickupLocation()" 
            class="w-full sm:w-auto bg-[#fff5f5] hover:bg-[#ffebee] border-2 border-[#ffcdd2] focus:border-[#e60012] text-[#3d231d] font-bold text-xs sm:text-sm px-3.5 py-2 rounded-xl outline-none cursor-pointer transition"
          >
            <option value="senado">🇲🇴 澳門議事亭前地店 (Senado Square)</option>
            <option value="campo">🇲🇴 澳門水坑尾旗艦店 (Rua do Campo)</option>
            <option value="taipa">🇲🇴 氹仔官也街店 (Rua do Cunha, Taipa)</option>
            <option value="cotai">🇲🇴 路氹威尼斯人店 (The Venetian Macao)</option>
            <option value="border">🇲🇴 澳門關閘廣場店 (Border Gate Plaza)</option>
          </select>
        </div>
      </div>

      <!-- 2. 外賣送貨地址輸入面板（預設隱藏） -->
      <div id="delivery-location-panel" class="hidden flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-[#fff3e0] text-[#d84315] flex items-center justify-center text-xl shrink-0">
            🛵
          </div>
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-[11px] font-bold text-[#d84315] bg-[#fff3e0] px-2 py-0.5 rounded-md">外賣配送地址 Delivery Location</span>
              <span class="text-[11px] font-bold text-[#2e7d32]">🎁 滿 $15.00 免運費</span>
            </div>
            <p id="delivery-fee-hint" class="text-xs text-[#5d4037] mt-1 font-medium">請選擇配送區域並填寫大廈／街道門牌（目前運費：$2.00）</p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 flex-1 lg:max-w-xl">
          <select 
            id="delivery-zone-select" 
            onchange="updateDeliveryLocation()" 
            class="bg-[#fff8e1] border-2 border-[#ffcc80] focus:border-[#e60012] text-[#3d231d] font-bold text-xs sm:text-sm px-3 py-2 rounded-xl outline-none cursor-pointer"
          >
            <option value="peninsula" data-fee="2.00" data-eta="25-35 分鐘送達">🇲🇴 澳門半島區 (+$2.00)</option>
            <option value="taipa" data-fee="2.50" data-eta="30-40 分鐘送達">🇲🇴 氹仔市區 / 官也街 (+$2.50)</option>
            <option value="cotai" data-fee="3.00" data-eta="35-45 分鐘送達">🇲🇴 路氹金光大道酒店區 (+$3.00)</option>
            <option value="coloane" data-fee="4.00" data-eta="40-50 分鐘送達">🇲🇴 路環市區 / 石排灣 (+$4.00)</option>
          </select>

          <input 
            type="text" 
            id="delivery-address-input" 
            oninput="updateDeliveryLocation()" 
            placeholder="輸入外賣詳細地址（例：新馬路120號XX大廈5樓B）..." 
            class="flex-1 bg-white border-2 border-[#ffcc80] focus:border-[#e60012] text-[#3d231d] placeholder-[#bcaaa4] text-xs sm:text-sm font-bold px-3.5 py-2 rounded-xl outline-none"
          >
        </div>
      </div>

    </div>
  </section>

  <!-- VIP 會員手機登入與專屬禮遇橫幅 -->
  <section class="max-w-6xl mx-auto px-4 pt-5">
    <div class="bg-gradient-to-r from-[#fff8e1] via-[#fffdf7] to-[#ffebee] rounded-[24px] p-4 sm:p-5 border-4 border-[#ffd54f] shadow-md">
      
      <!-- 未登入狀態：手機號碼登入/註冊表單（支援簡訊驗證碼或密碼） -->
      <div id="vip-guest-view" class="flex flex-col lg:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3 text-center lg:text-left">
          <div class="w-12 h-12 rounded-2xl bg-[#ffd54f] text-[#b71c1c] flex items-center justify-center text-2xl shadow-xs shrink-0">
            👑
          </div>
          <div>
            <h2 class="font-bold text-base sm:text-lg text-[#d84315] flex items-center justify-center lg:justify-start gap-2">
              雪王 VIP 會員俱樂部
              <span class="text-xs bg-[#e60012] text-white px-2.5 py-0.5 rounded-full animate-pulse">享全單 9 折</span>
            </h2>
            <p class="text-xs text-[#795548] mt-0.5">輸入手機號碼搭配 <strong class="text-[#e60012]">簡訊驗證碼</strong> 或 <strong class="text-[#e60012]">會員密碼</strong> 登入，立即享 9 折與積分！</p>
          </div>
        </div>

        <div class="w-full lg:w-auto flex flex-col gap-2">
          <!-- 登入模式切換標籤 -->
          <div class="flex items-center justify-center lg:justify-end gap-2 text-xs font-bold">
            <button 
              type="button" 
              id="tab-auth-sms" 
              onclick="switchVipAuthMode('sms')" 
              class="px-3 py-1 rounded-full bg-[#e60012] text-white shadow-xs transition cursor-pointer"
            >
              📱 簡訊驗證碼登入
            </button>
            <button 
              type="button" 
              id="tab-auth-pwd" 
              onclick="switchVipAuthMode('password')" 
              class="px-3 py-1 rounded-full bg-white text-[#795548] border border-[#ffcc80] hover:bg-[#fff3e0] transition cursor-pointer"
            >
              🔑 密碼登入
            </button>
          </div>

          <!-- 手機號碼 + 驗證碼/密碼輸入列 -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
            <!-- 手機號碼框 -->
            <div class="flex items-center bg-white border-2 border-[#ffcc80] focus-within:border-[#e60012] rounded-2xl overflow-hidden shadow-xs">
              <select id="vip-country-code" class="bg-[#fff8e1] text-[#5d4037] font-bold text-xs sm:text-sm px-2.5 py-2 outline-none border-r border-[#ffe0b2] cursor-pointer">
                <option value="+853">🇲🇴 +853</option>
                <option value="+852">🇭🇰 +852</option>
                <option value="+86">🇨🇳 +86</option>
                <option value="+886">🇹🇼 +886</option>
              </select>
              <input 
                type="tel" 
                id="vip-phone-input" 
                placeholder="手機號碼..." 
                maxlength="11"
                class="px-3 py-2 text-sm font-bold text-[#3d231d] placeholder-[#bcaaa4] outline-none w-full sm:w-32"
              >
            </div>

            <!-- 簡訊驗證碼輸入區 -->
            <div id="auth-sms-box" class="flex items-center bg-white border-2 border-[#ffcc80] focus-within:border-[#e60012] rounded-2xl overflow-hidden shadow-xs">
              <input 
                type="text" 
                id="vip-sms-input" 
                placeholder="6位驗證碼" 
                maxlength="6"
                onkeydown="if(event.key==='Enter') loginVip()"
                class="px-3 py-2 text-sm font-bold text-[#3d231d] placeholder-[#bcaaa4] outline-none w-24 sm:w-28 tracking-widest"
              >
              <button 
                type="button" 
                id="send-sms-btn" 
                onclick="sendSmsCode()" 
                class="bg-[#fff3e0] hover:bg-[#ffe0b2] disabled:opacity-50 disabled:cursor-not-allowed text-[#d84315] font-bold text-xs px-2.5 py-2 border-l border-[#ffe0b2] whitespace-nowrap transition cursor-pointer"
              >
                獲取驗證碼
              </button>
            </div>

            <!-- 密碼輸入區（預設隱藏） -->
            <div id="auth-pwd-box" class="hidden items-center bg-white border-2 border-[#ffcc80] focus-within:border-[#e60012] rounded-2xl overflow-hidden shadow-xs">
              <input 
                type="password" 
                id="vip-pwd-input" 
                placeholder="輸入會員密碼..." 
                maxlength="20"
                onkeydown="if(event.key==='Enter') loginVip()"
                class="px-3 py-2 text-sm font-bold text-[#3d231d] placeholder-[#bcaaa4] outline-none w-full sm:w-40"
              >
            </div>

            <div class="flex items-center gap-1.5">
              <button 
                type="button" 
                onclick="loginVip()" 
                class="flex-1 sm:flex-none bg-[#e60012] hover:bg-[#cc0010] text-white font-bold text-sm px-4 py-2 rounded-2xl shadow-sm active:scale-95 transition cursor-pointer whitespace-nowrap"
              >
                ✨ 登入
              </button>
              <button 
                type="button" 
                onclick="fillDemoVip()" 
                class="bg-[#ffd54f] hover:bg-[#ffca28] text-[#5d4037] font-bold text-xs px-3 py-2 rounded-2xl shadow-xs active:scale-95 transition cursor-pointer whitespace-nowrap"
                title="自動填入示範帳號並驗證登入"
              >
                ⚡ 一鍵體驗
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- 已登入狀態：VIP 會員資訊卡片 -->
      <div id="vip-member-view" class="hidden flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3.5">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-[#ffd54f] to-[#ff9800] text-white flex items-center justify-center text-2xl shadow-sm shrink-0">
            👑
          </div>
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <span id="vip-tier-badge" class="bg-[#e60012] text-white text-xs font-bold px-2.5 py-0.5 rounded-full">黃金雪王 VIP</span>
              <span id="vip-display-phone" class="font-bold text-base text-[#3d231d]">+853 6688 9900</span>
              <span class="bg-[#e8f5e9] text-[#2e7d32] border border-[#a5d6a7] text-xs font-bold px-2 py-0.5 rounded-full">✓ 已啟用 9 折特權</span>
            </div>
            <p class="text-xs text-[#795548] mt-1">
              目前可用積分：<strong id="vip-points-display" class="text-base text-[#e60012]">250</strong> 積分
              <span class="text-[#a1887f] ml-1">（每滿 100 積分結帳可折抵 $2.00）</span>
            </p>
          </div>
        </div>

        <button 
          type="button" 
          onclick="logoutVip()" 
          class="text-xs font-bold text-[#8d6e63] hover:text-[#e60012] bg-white border border-[#ffe0b2] px-3.5 py-2 rounded-xl transition cursor-pointer"
        >
          切換帳號 / 登出
        </button>
      </div>

    </div>
  </section>

  <!-- 主內容區塊：桌面版左右雙欄（左側菜單 + 右側懸浮購物車），手機版上下堆疊 -->
  <main class="max-w-6xl mx-auto px-4 pt-5 sm:pt-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      
      <!-- 左側：飲品分類與菜單區 (佔 8 欄) -->
      <section class="lg:col-span-8">
        <!-- 分類篩選標籤列 -->
        <div class="bg-white rounded-2xl p-3 shadow-sm border-2 border-[#ffe0e3] mb-6 flex flex-wrap items-center justify-between gap-2">
          <div class="flex flex-wrap gap-2" id="category-tabs">
            <button onclick="filterCategory('all')" data-cat="all" class="cat-btn active bg-[#e60012] text-white font-bold px-4 py-2 rounded-xl text-sm shadow-sm transition cursor-pointer">
              ✨ 全部飲品 (All)
            </button>
            <button onclick="filterCategory('milktea')" data-cat="milktea" class="cat-btn bg-[#fff5f5] text-[#5d4037] hover:bg-[#ffe3e6] font-bold px-4 py-2 rounded-xl text-sm transition cursor-pointer">
              🧋 醇香奶茶 (Milk Tea)
            </button>
            <button onclick="filterCategory('fruittea')" data-cat="fruittea" class="cat-btn bg-[#fff5f5] text-[#5d4037] hover:bg-[#ffe3e6] font-bold px-4 py-2 rounded-xl text-sm transition cursor-pointer">
              🍋 鮮果茶飲 (Fruit Tea)
            </button>
            <button onclick="filterCategory('icecream')" data-cat="icecream" class="cat-btn bg-[#fff5f5] text-[#5d4037] hover:bg-[#ffe3e6] font-bold px-4 py-2 rounded-xl text-sm transition cursor-pointer">
              🍦 冰淇淋聖代 (Ice Cream)
            </button>
          </div>
          <span class="text-xs text-[#8d6e63] px-2">點擊飲品可客製冰塊、甜度與加料！</span>
        </div>

        <!-- 飲品網格列表 -->
        <div id="menu-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 sm:gap-5">
          <!-- 菜單卡片由 JavaScript 動態產生 -->
        </div>
      </section>

      <!-- 右側：購物車面板 (佔 4 欄，桌面版固定在右側) -->
      <aside id="shopping-cart-section" class="lg:col-span-4 lg:sticky lg:top-24">
        <div class="bg-white rounded-[28px] shadow-[0_12px_35px_rgba(230,0,18,0.12)] border-4 border-[#ffd54f] overflow-hidden">
          
          <!-- 購物車標題列 -->
          <div class="bg-[#fff8e1] px-5 py-4 border-b-2 border-dashed border-[#ffe082] flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-2xl">🛒</span>
              <h2 class="text-lg font-bold text-[#d84315]">我的點餐購物車</h2>
            </div>
            <span id="cart-count-badge" class="bg-[#e60012] text-white text-xs font-bold px-2.5 py-1 rounded-full shadow-sm">
              0 杯
            </span>
          </div>

          <!-- 購物車內容清單 -->
          <div id="cart-items-container" class="p-4 max-h-[420px] overflow-y-auto space-y-3">
            <!-- 空購物車預設提示 -->
            <div id="empty-cart-msg" class="py-10 text-center text-[#a1887f]">
              <div class="text-5xl mb-3 opacity-80">🧋</div>
              <p class="font-bold text-base text-[#5d4037]">購物車還是空的喔！</p>
              <p class="text-xs mt-1">快從左邊挑選喜歡的甜蜜飲品吧～</p>
            </div>
          </div>

          <!-- 購物車底部結算區 -->
          <div class="bg-[#fffdf7] p-5 border-t-2 border-[#ffe0b2]">
            <!-- 取餐 / 外賣地點確認提示 -->
            <div class="bg-[#ffebee]/70 border border-[#ffcdd2] rounded-xl px-3 py-2 mb-3 text-xs space-y-0.5">
              <div class="flex items-center justify-between">
                <span id="cart-location-label" class="text-[#795548] font-bold">🛍️ 外帶地點：</span>
                <span id="cart-takeout-store" class="font-bold text-[#e60012]">澳門議事亭前地店</span>
              </div>
              <p id="cart-delivery-address-preview" class="hidden text-[11px] text-[#5d4037] truncate">請於上方輸入外賣送貨地址</p>
            </div>

            <!-- 金額明細計算 -->
            <div class="space-y-1.5 text-sm mb-3 pb-3 border-b border-dashed border-[#ffe0b2]">
              <div class="flex justify-between items-center text-[#8d6e63]">
                <span>飲品小計 (<span id="summary-qty" class="font-bold text-[#4e342e]">0 杯</span>)</span>
                <span id="summary-subtotal" class="font-bold text-[#4e342e]">$0.00</span>
              </div>

              <!-- 外賣配送費顯示 -->
              <div id="delivery-fee-row" class="hidden justify-between items-center text-[#d84315] font-bold">
                <span>🛵 外賣配送費 <span id="delivery-free-tag" class="hidden text-[10px] bg-[#e8f5e9] text-[#2e7d32] px-1.5 py-0.5 rounded ml-1">滿$15免運</span></span>
                <span id="summary-delivery-fee">$2.00</span>
              </div>

              <!-- VIP 9 折優惠顯示 -->
              <div id="vip-discount-row" class="hidden justify-between items-center text-[#2e7d32] font-bold">
                <span>👑 VIP 專享 9 折 (10% OFF)</span>
                <span id="summary-vip-discount">-$0.00</span>
              </div>

              <!-- 未登入 VIP 提示條 -->
              <div id="vip-upsell-tip" class="bg-[#fff3e0] text-[#d84315] text-xs px-2.5 py-1.5 rounded-xl flex items-center justify-between">
                <span>💡 登入手機 VIP 立即享 9 折！</span>
                <button type="button" onclick="fillDemoVip()" class="underline font-bold hover:text-[#e60012] cursor-pointer">立即登入</button>
              </div>

              <!-- 積分折抵勾選區（登入且積分 >= 100 且有商品時顯示） -->
              <div id="points-redeem-box" class="hidden pt-1">
                <label class="flex items-center justify-between bg-[#fff8e1] border border-[#ffd54f] px-2.5 py-1.5 rounded-xl cursor-pointer select-none">
