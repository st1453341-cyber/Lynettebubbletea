    }

    function loginVip() {
      const code = document.getElementById('vip-country-code').value;
      const rawPhone = document.getElementById('vip-phone-input').value.trim().replace(/\s+/g, '');

      if (!/^\d{6,11}$/.test(rawPhone)) {
        showToast('⚠️ 請輸入 6 至 11 位有效手機號碼！');
        return;
      }

      const accountKey = `${code}-${rawPhone}`;
      let isNewMember = false;

      if (vipAuthMode === 'sms') {
        const inputCode = document.getElementById('vip-sms-input').value.trim();
        if (!generatedSmsCode || generatedSmsTarget !== accountKey) {
          showToast('⚠️ 請先點擊「獲取驗證碼」！');
          return;
        }
        if (inputCode !== generatedSmsCode) {
          showToast('❌ 驗證碼錯誤，請重新確認！');
          return;
        }

        // 驗證碼通過，若為新號碼則自動建立帳號（預設密碼 123456）
        if (!VIP_ACCOUNTS_DB[accountKey]) {
          VIP_ACCOUNTS_DB[accountKey] = {
            tier: '甜蜜新星 VIP',
            points: 100,
            password: '123456'
          };
          isNewMember = true;
        }
      } else {
        // 密碼登入模式
        const inputPwd = document.getElementById('vip-pwd-input').value;
        if (!inputPwd || inputPwd.length < 4) {
          showToast('⚠️ 請輸入至少 4 位數會員密碼！');
          return;
        }

        if (!VIP_ACCOUNTS_DB[accountKey]) {
          // 首次使用密碼直接註冊新帳號
          VIP_ACCOUNTS_DB[accountKey] = {
            tier: '甜蜜新星 VIP',
            points: 100,
            password: inputPwd
          };
          isNewMember = true;
        } else if (VIP_ACCOUNTS_DB[accountKey].password !== inputPwd) {
          showToast('❌ 密碼錯誤！（示範帳號密碼為 123456）');
          return;
        }
      }

      vipState.isLoggedIn = true;
      vipState.countryCode = code;
      vipState.phone = rawPhone;
      vipState.tier = VIP_ACCOUNTS_DB[accountKey].tier;
      vipState.points = VIP_ACCOUNTS_DB[accountKey].points;

      document.getElementById('sms-banner').classList.add('hidden');
      updateVipUI();
      renderCart();

      if (isNewMember) {
        showToast('🎉 新 VIP 註冊成功！贈送 100 積分並享全單 9 折（預設密碼 123456）！');
      } else {
        showToast(`👑 驗證成功！歡迎 VIP 會員 ${code} ${rawPhone}`);
      }
    }

