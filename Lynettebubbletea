      const sizeLabel = sizeInput ? sizeInput.getAttribute('data-label') : '中杯 (M)';
      const iceLabel = iceInput ? iceInput.value : '正常冰';
      const sugarLabel = sugarInput ? sugarInput.value : '全糖 100%';

      const chosenToppings = [];
      document.querySelectorAll('.modal-topping-cb:checked').forEach(cb => {
        chosenToppings.push(cb.getAttribute('data-name').split(' ')[0]); // 取得中文名稱
      });

      const unitPrice = calculateModalUnitPrice();

      // 產生唯一組合鍵值，若完全相同規格則合併數量
      const configKey = `${selectedDrink.id}|${sizeLabel}|${iceLabel}|${sugarLabel}|${chosenToppings.sort().join(',')}`;

      const existingIndex = cart.findIndex(item => item.configKey === configKey);
      if (existingIndex > -1) {
        cart[existingIndex].qty += modalQty;
      } else {
        cart.push({
          configKey,
          name: selectedDrink.name,
          img: selectedDrink.img,
          size: sizeLabel,
          ice: iceLabel,
          sugar: sugarLabel,
          toppings: chosenToppings,
          unitPrice: unitPrice,
          qty: modalQty
        });
      }

      closeCustomizer();
      renderCart();
      showToast(`已將「${selectedDrink.name}」加入購物車！`);
    }

    // 調整購物車內某項商品數量
    function updateCartItemQty(index, delta) {
      if (!cart[index]) return;
      cart[index].qty += delta;
      if (cart[index].qty <= 0) {
        cart.splice(index, 1);
      }
      renderCart();
    }

    // 移除單一商品
    function removeCartItem(index) {
      cart.splice(index, 1);
      renderCart();
    }

    // 清空購物車
    function clearCart() {
      cart = [];
      renderCart();
      showToast('已清空購物車');
    }

    // 重新渲染購物車畫面與總金額
    function getCartPricing() {
      let totalQty = 0;
      let subtotal = 0;
      cart.forEach(item => {
        totalQty += item.qty;
        subtotal += item.unitPrice * item.qty;
      });

      // 計算外賣配送費（滿 $15.00 免運費）
      let deliveryFee = 0;
      let isFreeDelivery = false;
      if (orderMode === 'delivery' && totalQty > 0) {
        const zoneSelect = document.getElementById('delivery-zone-select');
        const selectedOpt = zoneSelect ? zoneSelect.options[zoneSelect.selectedIndex] : null;
        const baseFee = selectedOpt ? parseFloat(selectedOpt.getAttribute('data-fee') || '2.00') : 2.00;
        if (subtotal >= 15.00) {
          deliveryFee = 0;
          isFreeDelivery = true;
        } else {
          deliveryFee = baseFee;
        }
      }

      const vipDiscount = vipState.isLoggedIn ? subtotal * (1 - vipState.discountRate) : 0;
      const afterVip = subtotal - vipDiscount;

      const redeemCb = document.getElementById('use-points-checkbox');
      const canRedeem = vipState.isLoggedIn && vipState.points >= 100 && afterVip >= 2.00;
      const pointsDiscount = (canRedeem && redeemCb && redeemCb.checked) ? 2.00 : 0;

      const finalTotal = Math.max(0, afterVip - pointsDiscount + deliveryFee);
      return { totalQty, subtotal, deliveryFee, isFreeDelivery, vipDiscount, pointsDiscount, finalTotal, canRedeem };
    }

    function renderCart() {
      const container = document.getElementById('cart-items-container');
      const emptyMsg = document.getElementById('empty-cart-msg');
      const countBadge = document.getElementById('cart-count-badge');
      const mobileBadge = document.getElementById('mobile-cart-badge');
      const summaryQty = document.getElementById('summary-qty');
      const summarySubtotal = document.getElementById('summary-subtotal');
      const summaryTotal = document.getElementById('summary-total');
      const checkoutBtn = document.getElementById('checkout-btn');
      const clearBtn = document.getElementById('clear-cart-btn');

      const deliveryFeeRow = document.getElementById('delivery-fee-row');
      const summaryDeliveryFee = document.getElementById('summary-delivery-fee');
      const deliveryFreeTag = document.getElementById('delivery-free-tag');

      const vipDiscountRow = document.getElementById('vip-discount-row');
      const summaryVipDiscount = document.getElementById('summary-vip-discount');
      const vipUpsellTip = document.getElementById('vip-upsell-tip');
      const pointsRedeemBox = document.getElementById('points-redeem-box');

      const pricing = getCartPricing();

      countBadge.textContent = `${pricing.totalQty} 杯`;
      mobileBadge.textContent = pricing.totalQty;
      summaryQty.textContent = `${pricing.totalQty} 杯`;
      summarySubtotal.textContent = `$${pricing.subtotal.toFixed(2)}`;
      summaryTotal.textContent = `$${pricing.finalTotal.toFixed(2)}`;

      // 更新外賣運費列顯示
      if (orderMode === 'delivery' && pricing.totalQty > 0) {
        deliveryFeeRow.classList.remove('hidden');
        deliveryFeeRow.classList.add('flex');
        summaryDeliveryFee.textContent = pricing.isFreeDelivery ? '$0.00' : `+$${pricing.deliveryFee.toFixed(2)}`;
        if (pricing.isFreeDelivery) {
          deliveryFreeTag.classList.remove('hidden');
        } else {
          deliveryFreeTag.classList.add('hidden');
        }
      } else {
        deliveryFeeRow.classList.add('hidden');
        deliveryFeeRow.classList.remove('flex');
      }

      // 更新 VIP 優惠與積分折抵區塊顯示
      if (vipState.isLoggedIn) {
        vipUpsellTip.classList.add('hidden');
        vipDiscountRow.classList.remove('hidden');
        vipDiscountRow.classList.add('flex');
        summaryVipDiscount.textContent = `-$${pricing.vipDiscount.toFixed(2)}`;
      } else {
        vipUpsellTip.classList.remove('hidden');
        vipDiscountRow.classList.add('hidden');
        vipDiscountRow.classList.remove('flex');
      }

      if (pricing.canRedeem) {
        pointsRedeemBox.classList.remove('hidden');
      } else {
        pointsRedeemBox.classList.add('hidden');
        const redeemCb = document.getElementById('use-points-checkbox');
        if (redeemCb) redeemCb.checked = false;
      }

      if (cart.length === 0) {
        container.innerHTML = '';
        container.appendChild(emptyMsg);
        emptyMsg.classList.remove('hidden');
        checkoutBtn.disabled = true;
        clearBtn.disabled = true;
        return;
      }

      checkoutBtn.disabled = false;
      clearBtn.disabled = false;

      container.innerHTML = cart.map((item, idx) => {
        const toppingsText = item.toppings.length > 0 
          ? `加料：${item.toppings.join('、')}` 
          : '無加配料';
        const itemSubtotal = (item.unitPrice * item.qty).toFixed(2);

        return `
          <div class="bg-[#fffdf7] border-2 border-[#ffe0b2] rounded-2xl p-3 flex gap-3 items-start animate-pop relative">
            <img 
              src="${item.img}" 
              alt="${item.name}" 
              onerror="this.onerror=null; this.src='https://placehold.co/100x100/ffe082/e60012?text=Tea';"
              class="w-14 h-14 rounded-xl object-cover border border-[#ffcc80] shrink-0"
            >
            <div class="flex-1 min-w-0">
              <div class="flex justify-between items-start gap-1">
                <h4 class="font-bold text-sm text-[#3d231d] truncate">${item.name}</h4>
                <button onclick="removeCartItem(${idx})" class="text-[#bcaaa4] hover:text-[#e60012] text-xs px-1 cursor-pointer" title="移除此項">✕</button>
              </div>
              <p class="text-[11px] text-[#8d6e63] mt-0.5">${item.size} / ${item.ice} / ${item.sugar}</p>
              <p class="text-[11px] text-[#d84315] mt-0.5 truncate">${toppingsText}</p>

              <div class="flex items-center justify-between mt-2 pt-1.5 border-t border-dashed border-[#ffe0b2]">
                <span class="font-bold text-sm text-[#e60012]">$${itemSubtotal}</span>
                <div class="flex items-center gap-1.5 bg-white border border-[#ffcc80] rounded-lg px-1 py-0.5">
                  <button onclick="updateCartItemQty(${idx}, -1)" class="w-5 h-5 rounded bg-[#fff3e0] text-[#e60012] font-bold text-xs hover:bg-[#ffe0b2] cursor-pointer">-</button>
                  <span class="text-xs font-bold w-5 text-center">${item.qty}</span>
                  <button onclick="updateCartItemQty(${idx}, 1)" class="w-5 h-5 rounded bg-[#fff3e0] text-[#e60012] font-bold text-xs hover:bg-[#ffe0b2] cursor-pointer">+</button>
                </div>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    // ==========================================
    // 6. 微信支付 (WeChat Pay) 與結帳明細功能
    // ==========================================
    function drawWechatQrCode(seedText) {
      const canvas = document.getElementById('wx-qr-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const size = 176;
      const cells = 21;
      const cellSize = Math.floor(size / cells);

      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, size, size);

      // 產生偽隨機矩陣圖案模擬真實微信支付二維碼
      let hash = 0;
      for (let i = 0; i < seedText.length; i++) {
        hash = ((hash << 5) - hash) + seedText.charCodeAt(i);
        hash |= 0;
      }

      ctx.fillStyle = '#1a1a1a';
      for (let r = 0; r < cells; r++) {
        for (let c = 0; c < cells; c++) {
          // 跳過三個角落定位框區域
          const inTopLeft = r < 7 && c < 7;
          const inTopRight = r < 7 && c >= cells - 7;
          const inBottomLeft = r >= cells - 7 && c < 7;
          if (inTopLeft || inTopRight || inBottomLeft) continue;

          const val = Math.abs(Math.sin(hash + r * 31 + c * 17));
          if (val > 0.48) {
            ctx.fillRect(c * cellSize + 2, r * cellSize + 2, cellSize - 1, cellSize - 1);
          }
        }
      }

      // 繪製三個標準 QR 定位方框
      function drawFinder(x, y) {
        ctx.fillStyle = '#1a1a1a';
        ctx.fillRect(x, y, cellSize * 7, cellSize * 7);
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(x + cellSize, y + cellSize, cellSize * 5, cellSize * 5);
        ctx.fillStyle = '#07C160';
        ctx.fillRect(x + cellSize * 2, y + cellSize * 2, cellSize * 3, cellSize * 3);
      }
      drawFinder(2, 2);
      drawFinder((cells - 7) * cellSize + 2, 2);
      drawFinder(2, (cells - 7) * cellSize + 2);

      // 中央微信支付綠色圓角徽章
      const center = size / 2;
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(center, center, 18, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#07C160';
      ctx.beginPath();
      ctx.arc(center, center, 15, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 12px sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('¥', center, center + 1);
    }

    function openWechatPayModal() {
      if (cart.length === 0) return;

      if (orderMode === 'delivery' && !deliveryAddressText) {
        showToast('⚠️ 請先在上方輸入外賣送貨詳細地址！');
        document.getElementById('delivery-address-input').focus();
        return;
      }

      const pricing = getCartPricing();
      if (orderMode === 'takeout') {
        const store = PICKUP_STORES[currentPickupStoreKey] || PICKUP_STORES.senado;
        document.getElementById('wx-location-title').textContent = '🛍️ 外帶自取門市：';
        document.getElementById('wx-pickup-store').textContent = store.name;
      } else {
        const zoneSelect = document.getElementById('delivery-zone-select');
        const zoneLabel = zoneSelect.options[zoneSelect.selectedIndex].text.split(' (')[0];
        document.getElementById('wx-location-title').textContent = '🛵 外賣送達地址：';
        document.getElementById('wx-pickup-store').textContent = `${zoneLabel}・${deliveryAddressText}`;
      }
      document.getElementById('wx-pay-amount').textContent = `$${pricing.finalTotal.toFixed(2)}`;

      const wxVipTag = document.getElementById('wx-vip-tag');
      if (vipState.isLoggedIn) {
        wxVipTag.textContent = `👑 VIP 會員：${vipState.countryCode} ${vipState.phone}（已享 9 折）`;
        wxVipTag.className = 'inline-block bg-[#e8f5e9] border border-[#07C160] text-[#2e7d32] text-[11px] font-bold px-2.5 py-0.5 rounded-full mb-2';
      } else {
        wxVipTag.textContent = '訪客結帳（未綁定 VIP 手機）';
        wxVipTag.className = 'inline-block bg-[#fff8e1] border border-[#ffd54f] text-[#d84315] text-[11px] font-bold px-2.5 py-0.5 rounded-full mb-2';
      }

      drawWechatQrCode(`MIXUE-${Date.now()}-${pricing.finalTotal}`);

      // 啟動 5 分鐘倒數計時
      clearInterval(wxTimerInterval);
      let secondsLeft = 300;
      const countdownEl = document.getElementById('wx-countdown');
      countdownEl.textContent = '05:00';
      wxTimerInterval = setInterval(() => {
        secondsLeft--;
        if (secondsLeft <= 0) {
          clearInterval(wxTimerInterval);
          countdownEl.textContent = '已過期';
          return;
        }
        const m = String(Math.floor(secondsLeft / 60)).padStart(2, '0');
        const s = String(secondsLeft % 60).padStart(2, '0');
        countdownEl.textContent = `${m}:${s}`;
      }, 1000);

      const modal = document.getElementById('wechat-pay-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeWechatPayModal() {
      clearInterval(wxTimerInterval);
      const modal = document.getElementById('wechat-pay-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function confirmWechatPaymentSuccess() {
      closeWechatPayModal();
      const pricing = getCartPricing();

      // 產生隨機取餐號碼與微信交易單號
      const randomNo = Math.floor(100 + Math.random() * 900);
      const txId = `420000${Date.now().toString().slice(-10)}`;

      if (orderMode === 'takeout') {
        const store = PICKUP_STORES[currentPickupStoreKey] || PICKUP_STORES.senado;
        document.getElementById('receipt-location-label').textContent = '🛍️ 外帶取餐門市：';
        document.getElementById('receipt-pickup-store').textContent = store.name;
        document.getElementById('receipt-order-type').textContent = '門市外帶自取 (Take-Out)';
      } else {
        const zoneSelect = document.getElementById('delivery-zone-select');
        const zoneLabel = zoneSelect.options[zoneSelect.selectedIndex].text.split(' (')[0];
        document.getElementById('receipt-location-label').textContent = '🛵 外賣送貨地址：';
        document.getElementById('receipt-pickup-store').textContent = `${zoneLabel} ${deliveryAddressText}`;
        document.getElementById('receipt-order-type').textContent = '外賣騎手送貨上門 (Delivery)';
      }

      document.getElementById('receipt-order-no').textContent = `#A${randomNo}`;
      document.getElementById('receipt-wx-tx').textContent = txId;

      // 處理 VIP 積分扣除與新增（每消費 $1 獲得 10 積分）
      const receiptVipRow = document.getElementById('receipt-vip-row');
      if (vipState.isLoggedIn) {
        const earnedPoints = Math.round(pricing.finalTotal * 10);
        const spentPoints = pricing.pointsDiscount > 0 ? 100 : 0;
        vipState.points = Math.max(0, vipState.points - spentPoints + earnedPoints);

        const accountKey = `${vipState.countryCode}-${vipState.phone}`;
        if (VIP_ACCOUNTS_DB[accountKey]) {
          VIP_ACCOUNTS_DB[accountKey].points = vipState.points;
        }
        updateVipUI();

        receiptVipRow.classList.remove('hidden');
        receiptVipRow.classList.add('flex');
        document.getElementById('receipt-vip-earned').textContent = `${vipState.countryCode} ${vipState.phone} (+${earnedPoints} 積分)`;
      } else {
        receiptVipRow.classList.add('hidden');
        receiptVipRow.classList.remove('flex');
      }

      const receiptItemsHtml = cart.map(item => {
        const sub = item.unitPrice * item.qty;
        const topStr = item.toppings.length > 0 ? ` + ${item.toppings.join('、')}` : '';
        return `
          <div class="flex justify-between items-start border-b border-[#ffe0b2] pb-1.5 last:border-none">
            <div>
              <div class="font-bold text-[#3d231d]">${item.name} x${item.qty}</div>
              <div class="text-[11px] text-[#8d6e63]">${item.size}・${item.ice}・${item.sugar}${topStr}</div>
            </div>
            <span class="font-bold text-[#e60012]">$${sub.toFixed(2)}</span>
          </div>
        `;
      }).join('');

      document.getElementById('receipt-items').innerHTML = receiptItemsHtml;
      document.getElementById('receipt-total').textContent = `$${pricing.finalTotal.toFixed(2)}`;

      const receiptModal = document.getElementById('receipt-modal');
      receiptModal.classList.remove('hidden');
      receiptModal.classList.add('flex');
    }

    function finishAndResetOrder() {
      const receiptModal = document.getElementById('receipt-modal');
      receiptModal.classList.add('hidden');
      receiptModal.classList.remove('flex');
      cart = [];
      const redeemCb = document.getElementById('use-points-checkbox');
      if (redeemCb) redeemCb.checked = false;
      renderCart();
    }

    function scrollToCart() {
      document.getElementById('shopping-cart-section').scrollIntoView({ behavior: 'smooth' });
    }

    let toastTimer = null;
    function showToast(message) {
      const toast = document.getElementById('toast-msg');
      document.getElementById('toast-text').textContent = message;
      toast.classList.remove('opacity-0');
      toast.classList.add('opacity-100');

      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.remove('opacity-100');
        toast.classList.add('opacity-0');
      }, 2200);
    }

    // 頁面載入後初始化菜單與購物車
    window.addEventListener('DOMContentLoaded', () => {
      renderMenu();
      renderCart();
    });
  </script>
